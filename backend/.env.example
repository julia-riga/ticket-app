# Скопируйте файл в backend/.env и подставьте свое значение секрета:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# Обязательно. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./tickets.db
CORS_ORIGINS=["http://localhost:5173"]
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Токен хранится в httpOnly-куке. На проде (https) поставьте true,
# иначе браузер не будет отправлять куку.
COOKIE_SECURE=false
